# Copy this file to .env and adjust values for your machine.
# Never commit your real .env file.

# Where the SQLite database file is stored
CHAILEDGER_DATABASE=instance/chailedger.db

# Example payment rate per kg of confirmed green leaf (KES). Placeholder only.
CHAILEDGER_RATE_PER_KG=25

# Largest weight allowed in one weighing (catches typing mistakes)
CHAILEDGER_MAX_KG_PER_DELIVERY=150

# Address the server listens on
HOST=127.0.0.1

# Port for the development server
PORT=5000

# Set to 1 for auto-reload and debug pages during development
FLASK_DEBUG=0
